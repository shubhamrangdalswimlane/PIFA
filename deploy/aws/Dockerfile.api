# PIFA API (FastAPI + business rules) as a container for AWS. Build context: the repository root.
FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /srv
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt "uvicorn[standard]==0.37.0"
COPY pifa_api ./pifa_api
RUN useradd --uid 10001 --create-home svc
USER svc
EXPOSE 8000
# Migrations run automatically on the first request (see pifa_api/db.py).
CMD ["uvicorn", "pifa_api.main:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers"]
