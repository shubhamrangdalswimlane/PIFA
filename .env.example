# API (pifa_api) — local values; on Vercel set these in Project → Settings → Environment Variables.
DATABASE_URL=postgresql://pifa:pifa@localhost:5432/pifa
# Vercel: the Render Postgres *external* URL with ?sslmode=require
KEYCLOAK_ISSUER=http://localhost:8080/realms/printer-poc
KEYCLOAK_AUDIENCE=printer-api
SVC_CLIENT_ID=printer-api-svc
SVC_CLIENT_SECRET=local-svc-secret
RULES_URL=http://localhost:8091
FILES_URL=http://localhost:8082
ALLOWED_ORIGINS=http://localhost:5173

# docker compose
PIFA_SEED_PASSWORD=Pifa!2026
# SFTP_PUBLIC_KEY / SFTP_PRIVATE_KEY are written by scripts/dev_keys.py
