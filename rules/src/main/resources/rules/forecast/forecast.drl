package rules.forecast;

import com.pifa.rules.facts.QuantityChange;
import com.pifa.rules.facts.ReviewRequest;
import com.pifa.rules.facts.Violation;
import com.pifa.rules.facts.Checks;

global java.util.List violations;

rule "R-FC-01 quantity is a whole number >= 0"
when
    $c : QuantityChange( qtyValid == false )
then
    violations.add( new Violation( "R-FC-01", $c.getProduct(), $c.getRegion(),
        "Quantity " + Checks.fmt( $c.getQty() ) + " must be a whole number >= 0" ) );
end

rule "R-FC-02 every change needs a comment"
when
    $c : QuantityChange( revision == false, commentBlank == true )
then
    violations.add( new Violation( "R-FC-02", $c.getProduct(), $c.getRegion(),
        "A comment is required for every change" ) );
end

rule "R-FC-02 revision needs a reason"
when
    $c : QuantityChange( revision == true, commentBlank == true )
then
    violations.add( new Violation( "R-FC-02", $c.getProduct(), $c.getRegion(),
        "A reason is required for a Regional Manager revision" ) );
end

rule "R-FC-03 review decision must be APPROVE or REJECT"
when
    $r : ReviewRequest( decisionValid == false )
then
    violations.add( new Violation( "R-FC-03", null, null,
        "Review decision must be APPROVE or REJECT, got " + $r.getDecision() ) );
end

rule "R-FC-03 review rejection needs a comment"
when
    $r : ReviewRequest( decision == "REJECT", commentBlank == true )
then
    violations.add( new Violation( "R-FC-03", null, null,
        "Rejecting a regional forecast requires a comment for the Sales Manager" ) );
end
