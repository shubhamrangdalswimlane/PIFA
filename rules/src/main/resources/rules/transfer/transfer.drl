package rules.transfer;

import com.pifa.rules.facts.TransferRequest;
import com.pifa.rules.facts.Violation;
import com.pifa.rules.facts.Checks;

global java.util.List violations;

rule "R-XFER-01 regions must be valid"
when
    $t : TransferRequest( regionsValid == false )
then
    violations.add( new Violation( "R-XFER-01", $t.getProduct(), $t.getReportRegion(),
        "Transfer regions must be North, East, West or South (from " + $t.getFromRegion() + " to " + $t.getToRegion() + ")" ) );
end

rule "R-XFER-01 regions must differ"
when
    $t : TransferRequest( sameRegion == true )
then
    violations.add( new Violation( "R-XFER-01", $t.getProduct(), $t.getReportRegion(),
        "Transfer must move units between two different regions" ) );
end

rule "R-XFER-01 quantity is a whole number > 0"
when
    $t : TransferRequest( qtyValid == false )
then
    violations.add( new Violation( "R-XFER-01", $t.getProduct(), $t.getReportRegion(),
        "Transfer quantity " + Checks.fmt( $t.getQty() ) + " must be a whole number greater than 0" ) );
end

rule "R-XFER-01 quantity within source allocation"
when
    $t : TransferRequest( exceedsSource == true )
then
    violations.add( new Violation( "R-XFER-01", $t.getProduct(), $t.getReportRegion(),
        "Transfer quantity " + Checks.fmt( $t.getQty() ) + " exceeds source allocation " + Checks.fmt( $t.getSourceQty() ) ) );
end

rule "R-XFER-01 transfer needs a comment"
when
    $t : TransferRequest( commentBlank == true )
then
    violations.add( new Violation( "R-XFER-01", $t.getProduct(), $t.getReportRegion(),
        "A comment is required for every transfer" ) );
end
