package rules.approval;

import com.pifa.rules.facts.ApprovalRequest;
import com.pifa.rules.facts.Violation;

global java.util.List violations;

rule "R-APPR-01 only Head of Sales decides"
when
    $a : ApprovalRequest( headOfSales == false )
then
    violations.add( new Violation( "R-APPR-01", null, null,
        "Only HEAD_OF_SALES may approve or reject the final allocation (actor role " + $a.getActorRole() + ")" ) );
end

rule "R-APPR-01 decision must be APPROVE or REJECT"
when
    $a : ApprovalRequest( decisionValid == false )
then
    violations.add( new Violation( "R-APPR-01", null, null,
        "Decision must be APPROVE or REJECT, got " + $a.getDecision() ) );
end

rule "R-APPR-01 rejection needs a comment"
when
    ApprovalRequest( decision == "REJECT", commentBlank == true )
then
    violations.add( new Violation( "R-APPR-01", null, null,
        "Rejecting the final allocation requires a comment" ) );
end

rule "R-XFER-02 publish only after final approval stage"
when
    $a : ApprovalRequest( decision == "APPROVE", finalApprovalStage == false )
then
    violations.add( new Violation( "R-XFER-02", null, null,
        "Allocation and transfers can only be published from stage 5 (FINAL_APPROVAL), current stage " + $a.getStage() ) );
end
