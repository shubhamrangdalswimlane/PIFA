package rules.allocation;

import com.pifa.rules.AllocationMath;
import com.pifa.rules.facts.AllocationConfig;
import com.pifa.rules.facts.ModelDemand;
import com.pifa.rules.facts.ModelTotals;
import com.pifa.rules.facts.QuantityValue;
import com.pifa.rules.facts.Violation;
import com.pifa.rules.facts.Checks;

global java.util.List violations;
global java.util.List allocations;

// Configurable: baselinePct and sharing (UNMET_DEMAND | PROPORTIONAL) come from rule_config via AllocationConfig.
rule "R-ALLOC-01 allocate inventory by demand"
when
    $cfg : AllocationConfig( mode == "ALLOCATE" )
    $m   : ModelDemand( inputsValid == true )
then
    allocations.addAll( AllocationMath.allocateModel( $m, $cfg ) );
end

rule "R-ALLOC-02 allocation within inventory"
when
    AllocationConfig( mode == "VALIDATE" )
    $t : ModelTotals( allocated > inventory )
then
    violations.add( new Violation( "R-ALLOC-02", $t.getProduct(), null,
        "Allocated " + Checks.fmt( $t.getAllocated() ) + " exceeds inventory " + Checks.fmt( $t.getInventory() ) ) );
end

rule "R-FC-01 allocation quantity is a whole number >= 0"
when
    $q : QuantityValue( valid == false )
then
    violations.add( new Violation( "R-FC-01", $q.getProduct(), $q.getRegion(),
        "Value of " + $q.getField() + " " + Checks.fmt( $q.getQty() ) + " must be a whole number >= 0" ) );
end
