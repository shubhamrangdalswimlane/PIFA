# Keycloak base URL (no trailing /realms/...), e.g. https://pifa-keycloak.onrender.com or http://localhost:8080
VITE_KEYCLOAK_URL=http://localhost:8080
# Keycloak realm (default: printer-poc)
VITE_KEYCLOAK_REALM=printer-poc
# Public PKCE client id (default: printer-web)
VITE_KEYCLOAK_CLIENT=printer-web
# API base path. Same-origin /api on Vercel; the Vite dev server proxies /api to http://localhost:8000
VITE_API_BASE=/api
