{
  "realm": "printer-poc",
  "enabled": true,
  "displayName": "PIFA",
  "sslRequired": "external",
  "accessTokenLifespan": 900,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "bruteForceProtected": true,
  "failureFactor": 5,
  "loginWithEmailAllowed": false,
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "roles": {
    "realm": [
      {
        "name": "SALES_MANAGER",
        "description": "PIFA SALES_MANAGER"
      },
      {
        "name": "REGIONAL_MANAGER",
        "description": "PIFA REGIONAL_MANAGER"
      },
      {
        "name": "PLANNER",
        "description": "PIFA PLANNER"
      },
      {
        "name": "HEAD_OF_SALES",
        "description": "PIFA HEAD_OF_SALES"
      },
      {
        "name": "ADMIN",
        "description": "PIFA ADMIN"
      }
    ]
  },
  "clients": [
    {
      "clientId": "printer-web",
      "name": "PIFA web app",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "redirectUris": [
        "${PIFA_WEB_ORIGIN}/*",
        "http://localhost:5173/*"
      ],
      "webOrigins": [
        "${PIFA_WEB_ORIGIN}",
        "http://localhost:5173"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${PIFA_WEB_ORIGIN}/*##http://localhost:5173/*"
      },
      "protocolMappers": [
        {
          "name": "region",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "region",
            "claim.name": "region",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "printer-api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "printer-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "printer-api",
      "name": "PIFA API",
      "enabled": true,
      "bearerOnly": true,
      "publicClient": false
    },
    {
      "clientId": "printer-api-svc",
      "name": "PIFA service-to-service",
      "enabled": true,
      "publicClient": false,
      "secret": "${PIFA_SVC_CLIENT_SECRET}",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false
    },
    {
      "clientId": "printer-upstream",
      "name": "Upstream file drops",
      "enabled": true,
      "publicClient": false,
      "secret": "${PIFA_UPSTREAM_CLIENT_SECRET}",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false
    }
  ],
  "users": [
    {
      "username": "sm.north",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Sales Manager",
      "lastName": "North",
      "email": "sm.north@pifa.local",
      "credentials": [
        {
          "type": "password",
          "value": "${PIFA_SEED_PASSWORD}",
          "temporary": false
        }
      ],
      "realmRoles": [
        "SALES_MANAGER"
      ],
